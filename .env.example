# Copy to .env (git-ignored). Placeholders only - never commit real keys.
DASHSCOPE_API_KEY=sk-your-key-here
# International endpoint (default). Mainland endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_PLANNER=qwen-plus
QWEN_CLASSIFIER=qwen-flash
# 1 = no network, fixed replies (use for dev/tests)
LLM_MOCK=1

# demo clock: "today" for all date logic (Asia/Shanghai). Empty = real date.
DEMO_TODAY=2026-07-25
