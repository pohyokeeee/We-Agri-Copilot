# Copy to .env (git-ignored). Placeholders only - never commit real keys.
# Which provider answers chat and speech-to-text: dashscope (Qwen: production) or groq (stand-in for the demo build).
LLM_PROVIDER=dashscope

# --- Groq (only read when LLM_PROVIDER=groq; it has no text-to-speech, the app shows replies as text) ---
GROQ_API_KEY=gsk-your-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_PLANNER=openai/gpt-oss-120b
GROQ_CLASSIFIER=openai/gpt-oss-20b
GROQ_ASR=whisper-large-v3-turbo

# --- DashScope / Qwen (only read when LLM_PROVIDER=dashscope) ---
DASHSCOPE_API_KEY=sk-your-key-here
# International endpoint (default). Mainland endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_PLANNER=qwen-plus
QWEN_CLASSIFIER=qwen-flash
QWEN_ASR=qwen-audio-3.0-asr-flash
QWEN_TTS=qwen3-tts-flash
TTS_VOICE=Cherry
LLM_TIMEOUT=10
# 1 = no network, fixed replies (use for dev/tests)
LLM_MOCK=1
# Extra browser origins allowed to call the API (H5 preview through a tunnel), comma separated. localhost / LAN :10086 are allowed already.
CORS_ORIGINS=

# 1 = anyone who can reach the API may press 重置演示 (shared demo server). 0 = only this machine can.
DEMO_PUBLIC=0

# demo clock: "today" for all date logic (Asia/Shanghai). Empty = real date.
DEMO_TODAY=2026-07-25
